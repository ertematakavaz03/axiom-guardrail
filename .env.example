# PostgreSQL container credentials (local development only)
POSTGRES_DB=agentarena
POSTGRES_USER=agentarena
POSTGRES_PASSWORD=agentarena

# Backend connection URLs. Docker Compose supplies container-network defaults.
AGENTARENA_DATABASE_URL=postgresql+asyncpg://agentarena:agentarena@localhost:5432/agentarena
AGENTARENA_REDIS_URL=redis://localhost:6379/0

# Replace with a long random value outside local development.
AGENTARENA_JWT_SECRET=replace-with-a-long-random-secret
AGENTARENA_ACCESS_TOKEN_MINUTES=60
AGENTARENA_CORS_ORIGINS=http://localhost:3000

# Bounded worker and evaluation guardrails.
AGENTARENA_WORKER_CONCURRENCY=5
AGENTARENA_MAX_SCENARIO_INPUT_LENGTH=20000
AGENTARENA_MAX_CASES_PER_RUN=100
AGENTARENA_MAX_TOOL_CALLS_PER_CASE=10
AGENTARENA_MAX_TOTAL_TOKENS=100000
AGENTARENA_DEFAULT_CASE_TIMEOUT_SECONDS=30

# Optional credential passed server-side to Generic HTTP agents. Never exposed to web.
AGENTARENA_GENERIC_HTTP_SECRET=

# Configurable USD prices per one million tokens; no live pricing is hardcoded.
# Example: {"provider:model":{"input_per_million":1.0,"output_per_million":2.0}}
AGENTARENA_MODEL_PRICING_JSON={}

# Optional Langfuse pilot. Leave blank to disable without affecting execution.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Browser-visible API base URL, embedded at web build time.
NEXT_PUBLIC_API_URL=http://localhost:8000/v1

